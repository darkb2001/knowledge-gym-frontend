  "cards": [
    {
      "dot": "amber",
      "title": "Không đồng nhất hai outbox",
      "items": [
        "event_outbox phát Kafka; search_outbox đồng bộ ES trực tiếp.",
        "Eventual consistency: write DB xong chưa chắc index đã cập nhật.",
        "Relay retry có giới hạn; cần theo dõi failed/stuck rows."
      ]
    },
    {
      "dot": "cyan",
      "title": "Những gì chưa được hứa",
      "items": [
        "Không hứa exactly-once; redelivery cần idempotent consumer.",
        "BlogPublishedConsumer hiện acknowledge/log, không phải fan-out email hoàn chỉnh.",
        "AI jobs dùng queue trong PG và budget; không suy ra mọi job chạy qua Kafka."
      ]
    }
