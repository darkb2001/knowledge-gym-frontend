      "css": ".ds-field-label{display:block;margin-bottom:8px;font-size:14px;font-weight:500;color:rgb(var(--kg-strong,25 54 66));font-family:var(--font-geist, Geist),system-ui,sans-serif;}.ds-field{width:100%;min-height:44px;padding:10px 14px;border:1px solid rgb(var(--kg-control,85 113 123));border-radius:8px;background:var(--surface,rgb(var(--kg-surface,239 245 245)));color:var(--foreground,rgb(var(--kg-strong,25 54 66)));font-size:16px;font-family:var(--font-geist, Geist),system-ui,sans-serif;outline:none;transition:border-color 150ms cubic-bezier(.4,0,.2,1)}.ds-field::placeholder{color:rgb(var(--kg-subtle,63 89 101));opacity:1}.ds-field:focus{border-color:var(--accent,rgb(var(--kg-accent,18 101 122)));box-shadow:0 0 0 2px rgb(52 95 115 / 15%)}@media(prefers-reduced-motion:reduce){.ds-field{transition:none}}"
    },
    {
      "name": "Active navigation row",
      "kind": "nav",
      "refersTo": "nav-active",
      "description": "Current-page selection with a genuine Phosphor SVG.",
      "html": "<nav aria-label=\"Điều hướng chính\"><a href=\"#learn\" aria-current=\"page\" class=\"ds-nav\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"19\" height=\"19\" fill=\"currentColor\" viewBox=\"0 0 256 256\" aria-hidden=\"true\"><path d=\"M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm51.58,57.79-32,64a4.08,4.08,0,0,1-1.79,1.79l-64,32a4,4,0,0,1-5.37-5.37l32-64a4.08,4.08,0,0,1,1.79-1.79l64-32A4,4,0,0,1,179.58,81.79Z\"></path></svg><span>Chọn chủ đề</span></a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:12px;min-height:44px;padding:10px 14px;border-radius:8px;background:rgb(var(--kg-sage,207 225 221));color:rgb(var(--kg-strong,25 54 66));font-size:13px;line-height:1.5;font-weight:500;text-decoration:none;font-family:var(--font-geist, Geist),system-ui,sans-serif;transition:color 150ms cubic-bezier(.4,0,.2,1)}.ds-nav svg{flex-shrink:0}.ds-nav:hover{color:rgb(var(--kg-strong,25 54 66))}.ds-nav:focus-visible{outline:2px solid var(--accent,rgb(var(--kg-accent,18 101 122)));outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-nav{transition:none}}"
    },
    {
      "name": "Selected topic filter",
      "kind": "chip",
      "refersTo": "topic-selected",
      "description": "An actual button, not a decorative content tag.",
      "html": "<button type=\"button\" aria-pressed=\"true\" class=\"ds-topic\">Java</button>",
      "css": ".ds-topic{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;font-size:14px;line-height:20px;border-radius:8px;font-family:var(--font-geist, Geist),system-ui,sans-serif;transition:background-color 150ms cubic-bezier(.4,0,.2,1);border:1px solid rgb(var(--kg-accent,18 101 122));padding:10px 20px;border-radius:9999px;background:var(--accent,rgb(var(--kg-accent,18 101 122)));color:rgb(var(--kg-on-accent,244 251 251));font-weight:500;cursor:pointer}.ds-topic:hover{border-color:rgb(var(--kg-accent,18 101 122))}.ds-topic:focus-visible{outline:2px solid var(--accent,rgb(var(--kg-accent,18 101 122)));outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-topic{transition:none}}"
    },
    {
      "name": "Working panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Quiet reading surface in either theme, with a tonal boundary.",
      "html": "<section class=\"ds-panel\"><h2>Ghi chú của bạn</h2><p>Lưu điều bạn muốn nhớ.</p></section>",
      "css": ".ds-panel{border:1px solid rgb(var(--kg-line,170 191 197) / 0.80);border-radius:16px;padding:20px;background:var(--surface,rgb(var(--kg-surface,239 245 245)));color:rgb(var(--kg-body,48 79 91));font-family:var(--font-geist, Geist),system-ui,sans-serif;}.ds-panel h2{margin:0 0 8px;color:rgb(var(--kg-strong,25 54 66));font-size:18px;font-weight:600;letter-spacing:-.02em}.ds-panel p{margin:0;color:rgb(var(--kg-subtle,63 89 101));font-size:16px;line-height:1.5}@media(min-width:640px){.ds-panel{padding:24px}}"
    }
  ],
  "narrative": {
    "northStar": "Alpine Commons",
    "overview": "A quiet learning workspace in an original layered mountain landscape. Daylight uses mist-blue surfaces and deep teal actions; night uses navy surfaces and pale aqua actions. The owner supplied light/dark login references and explicitly requested replacing the former beige background without changing fields or authentication behavior.\n\nThe atmosphere belongs behind the task. Authentication uses a translucent window and an illustrated side panel; learning and administration retain near-opaque reading planes, native controls and the existing task hierarchy. Source authority is app/scenic.css, lib/theme.ts, tailwind.config.ts and components/ui.tsx. This is a code-led interpretation of the supplied references, not a pixel-for-pixel screenshot recreation.",
    "keyCharacteristics": [
      "Original layered mountain, pine forest, river and day/night sky artwork.",
      "Persistent light/dark preference, with daylight as the initial default.",
      "Locally bundled Geist typography and genuine Phosphor icons.",
      "Translucent authentication, quiet near-opaque learning surfaces."
    ],
    "rules": [
      {
        "name": "The Boundary Rule",
        "body": "Editable controls use control, not the quieter line color.",
        "section": "colors"
      },
      {
        "name": "The Workhorse Rule",
        "body": "Preserve the locally served type family and source-language learning content.",
        "section": "typography"
      },
      {
        "name": "The Reading Plane Rule",
        "body": "Atmosphere stays behind tasks; reading/editor surfaces do not inherit the auth window's transparency.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse semantic colors in both themes, including SVG text labels.",
      "Do keep authentication fields, validation, API calls and redirects unchanged.",
      "Do keep continuous scenic movement behind content and honor reduced motion.",
      "Do check iPhone 13 portrait/landscape and narrow mobile layouts."
    ],
    "donts": [
      "Don't ship the reference screenshots as backgrounds or call this a literal recreation.",
      "Don't put transparent reading text directly on moving terrain.",
      "Don't introduce fixed-height mobile forms or prevent native page scrolling.",
      "Don't invent study statistics, outcomes or translated learning content."
    ]
  }
}
